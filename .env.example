APP_NAME="BIO-Notifier"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Kolkata
APP_URL=http://localhost
CENTRAL_DOMAIN=localhost

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=bio_notifier
DB_USERNAME=postgres
DB_PASSWORD=

BROADCAST_CONNECTION=log
CACHE_STORE=database
# Optional short-lived UI reference lists only; sessions and queues stay in PostgreSQL.
REFERENCE_CACHE_ENABLED=true
REDIS_REFERENCE_HOST=127.0.0.1
REDIS_REFERENCE_PORT=6379
REDIS_REFERENCE_DB=2
DB_CACHE_CONNECTION="${DB_CONNECTION}"
QUEUE_CONNECTION=database
DB_QUEUE_CONNECTION="${DB_CONNECTION}"
SESSION_DRIVER=database
SESSION_CONNECTION=pgsql
SESSION_LIFETIME=120

WHATSAPP_INSTANCE_NAME="bio_notifier"
WHATSAPP_API_KEY=""

# Operator-managed origins only. The device listener uses a separate port.
DEVICE_GATEWAY_ALLOWED_ORIGINS=http://127.0.0.1:8081
DEVICE_GATEWAY_MAX_PENDING_RECEIPTS=10000
DB_QUEUE_RETRY_AFTER=120

# Optional emergency switch; supported firmware and binding checks remain mandatory.
DEVICE_ACCESS_GROUPS_ENABLED=true

# Independent device-user expiration rules; exact firmware checks apply.
DEVICE_USER_EXPIRATION_ENABLED=true
